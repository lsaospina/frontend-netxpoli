<%- include('partials/header') %>

<div class="catalog-container">
    <!-- Encabezado del Catálogo -->
    <div class="catalog-header">
        <div class="catalog-title-section">
            <h1>Catálogo de Películas</h1>
            <p>Explora y alquila las mejores producciones desde la comodidad de tu hogar.</p>
        </div>
        
        <!-- Barra de Búsqueda -->
        <div class="search-bar-wrapper">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input type="text" id="catalog-search" placeholder="Buscar por título, director..." autocomplete="off">
        </div>
    </div>

    <!-- Filtros de Género -->
    <div class="genre-filters-section">
        <span class="filters-label"><i class="fa-solid fa-sliders"></i> Filtrar por Género:</span>
        <div class="genre-buttons" id="genre-buttons-container">
            <button class="genre-btn active" data-genre="all">Todos</button>
            <% genres.forEach(function(genre) { %>
                <button class="genre-btn" data-genre="<%= genre %>"><%= genre %></button>
            <% }); %>
        </div>
    </div>

    <!-- Mensaje si no hay resultados -->
    <div id="no-movies-found" class="no-results-container" style="display: none;">
        <i class="fa-solid fa-video-slash"></i>
        <h3>No se encontraron películas</h3>
        <p>Prueba buscando con otros términos o seleccionando otro género.</p>
    </div>

    <!-- Grid de Películas -->
    <div class="movies-grid" id="movies-grid-container">
        <% movies.forEach(function(movie) { %>
            <div class="movie-card" data-title="<%= movie.titulo.toLowerCase() %>" data-director="<%= movie.director.toLowerCase() %>" data-genre="<%= movie.genero %>">
                <!-- Portada de la película -->
                <div class="movie-poster-wrapper">
                    <img class="movie-poster-img" src="<%= movie.imagen_url %>" alt="<%= movie.titulo %>" loading="lazy">
                    <!-- Overlay de Sinopsis al hacer hover -->
                    <div class="movie-poster-overlay">
                        <div class="overlay-content">
                            <span class="overlay-genre-badge"><%= movie.genero %></span>
                            <p class="overlay-synopsis"><%= movie.sinopsis %></p>
                            <div class="overlay-info-row">
                                <span><i class="fa-regular fa-clock"></i> <%= movie.duracion %> min</span>
                                <span><i class="fa-regular fa-calendar"></i> <%= movie.ano %></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Detalles de la película -->
                <div class="movie-card-body">
                    <span class="movie-genre-label"><%= movie.genero %></span>
                    <h3 class="movie-card-title"><%= movie.titulo %></h3>
                    <p class="movie-card-director">Director: <span><%= movie.director %></span></p>
                    
                    <%# Rating Section %>
                    <div class="movie-rating-section" data-movie-id="<%= movie.id %>">
                        <div class="movie-avg-rating">
                            <div class="stars-display">
                                <% 
                                    var avgRating = movie.calificacion || 0;
                                    for (var s = 1; s <= 5; s++) {
                                        if (s <= Math.floor(avgRating)) { %>
                                            <i class="fa-solid fa-star star-filled"></i>
                                        <% } else if (s - 0.5 <= avgRating) { %>
                                            <i class="fa-solid fa-star-half-stroke star-filled"></i>
                                        <% } else { %>
                                            <i class="fa-regular fa-star star-empty"></i>
                                        <% } 
                                    } %>
                            </div>
                            <span class="avg-rating-value"><%= avgRating.toFixed(1) %></span>
                        </div>
                        <% if (user.tipo_usuario === 'cliente') { %>
                            <div class="user-rating-input">
                                <span class="rate-label">Tu calificación:</span>
                                <div class="star-input-group" data-movie-id="<%= movie.id %>">
                                    <% var userRating = (typeof userRatings !== 'undefined' && userRatings[movie.id]) ? userRatings[movie.id] : 0; %>
                                    <% for (var r = 1; r <= 5; r++) { %>
                                        <i class="fa-star star-btn <%= r <= userRating ? 'fa-solid active' : 'fa-regular' %>" 
                                           data-value="<%= r %>"
                                           title="<%= r %> estrella<%= r > 1 ? 's' : '' %>"></i>
                                    <% } %>
                                </div>
                            </div>
                        <% } %>
                    </div>

                    <div class="movie-card-meta">
                        <div class="movie-price-tag">
                            <span class="price-symbol">$</span><%= movie.precio_alquiler.toFixed(2) %>
                        </div>
                        <div class="movie-stock-tag <%= movie.stock > 0 ? 'in-stock' : 'out-of-stock' %>">
                            <% if (movie.stock > 0) { %>
                                <i class="fa-solid fa-circle-check"></i> <%= movie.stock %> Disp.
                            <% } else { %>
                                <i class="fa-solid fa-circle-xmark"></i> Agotado
                            <% } %>
                        </div>
                    </div>

                    <!-- Botón de acción -->
                    <div class="movie-action-section">
                        <% if (user.tipo_usuario === 'cliente') { %>
                            <% if (movie.stock > 0) { %>
                                <button class="btn-add-to-cart" 
                                        data-id="<%= movie.id %>" 
                                        data-title="<%= movie.titulo %>"
                                        data-price="<%= movie.precio_alquiler %>"
                                        data-image="<%= movie.imagen_url %>">
                                    <i class="fa-solid fa-cart-plus"></i> Agregar al carrito
                                </button>
                            <% } else { %>
                                <button class="btn-add-to-cart disabled" disabled>
                                    <i class="fa-solid fa-ban"></i> No disponible
                                </button>
                            <% } %>
                        <% } else { %>
                            <button class="btn-edit-movie-mock" data-id="<%= movie.id %>" data-title="<%= movie.titulo %>">
                                <i class="fa-solid fa-pen-to-square"></i> Editar Título
                            </button>
                        <% } %>
                    </div>
                </div>
            </div>
        <% }); %>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const searchInput = document.getElementById('catalog-search');
        const genreButtons = document.querySelectorAll('.genre-btn');
        const movieCards = document.querySelectorAll('.movie-card');
        const noResults = document.getElementById('no-movies-found');
        const gridContainer = document.getElementById('movies-grid-container');

        let currentGenre = 'all';
        let searchQuery = '';

        // Función para aplicar filtros combinados (búsqueda + género)
        function filterMovies() {
            let visibleCount = 0;

            movieCards.forEach(card => {
                const title = card.getAttribute('data-title');
                const director = card.getAttribute('data-director');
                const genre = card.getAttribute('data-genre');

                const matchesSearch = title.includes(searchQuery) || director.includes(searchQuery);
                const matchesGenre = currentGenre === 'all' || genre === currentGenre;

                if (matchesSearch && matchesGenre) {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            // Mostrar/Ocultar mensaje de no resultados
            if (visibleCount === 0) {
                noResults.style.display = 'flex';
                gridContainer.style.display = 'none';
            } else {
                noResults.style.display = 'none';
                gridContainer.style.display = 'grid';
            }
        }

        // Evento de búsqueda
        searchInput.addEventListener('input', (e) => {
            searchQuery = e.target.value.toLowerCase().trim();
            filterMovies();
        });

        // Evento de botones de género
        genreButtons.forEach(button => {
            button.addEventListener('click', () => {
                // Quitar clase activa a todos y ponerla al actual
                genreButtons.forEach(btn => btn.classList.remove('active'));
                button.classList.add('active');

                currentGenre = button.getAttribute('data-genre');
                filterMovies();
            });
        });

        // Funcionalidad de edición simulada para Gerentes/Admins
        const editButtonsMock = document.querySelectorAll('.btn-edit-movie-mock');
        editButtonsMock.forEach(button => {
            button.addEventListener('click', () => {
                const movieTitle = button.getAttribute('data-title');
                if (typeof showToast === 'function') {
                    showToast('Gestión de Catálogo', `Módulo de edición para "${movieTitle}" está en desarrollo.`, 'success');
                } else {
                    alert(`Módulo de edición para "${movieTitle}" en desarrollo.`);
                }
            });
        });

        // === Funcionalidad de Calificación con Estrellas ===
        document.querySelectorAll('.star-input-group').forEach(group => {
            const stars = group.querySelectorAll('.star-btn');
            const movieId = group.getAttribute('data-movie-id');

            // Hover effects
            stars.forEach((star, index) => {
                star.addEventListener('mouseenter', () => {
                    stars.forEach((s, i) => {
                        if (i <= index) {
                            s.classList.add('fa-solid', 'hover');
                            s.classList.remove('fa-regular');
                        } else {
                            if (!s.classList.contains('active')) {
                                s.classList.remove('fa-solid', 'hover');
                                s.classList.add('fa-regular');
                            }
                        }
                    });
                });

                star.addEventListener('mouseleave', () => {
                    stars.forEach(s => {
                        s.classList.remove('hover');
                        if (s.classList.contains('active')) {
                            s.classList.add('fa-solid');
                            s.classList.remove('fa-regular');
                        } else {
                            s.classList.remove('fa-solid');
                            s.classList.add('fa-regular');
                        }
                    });
                });

                // Click to rate
                star.addEventListener('click', async () => {
                    const ratingValue = parseInt(star.getAttribute('data-value'));
                    
                    try {
                        const response = await fetch(`/api/ratings/${movieId}`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ rating: ratingValue })
                        });
                        const data = await response.json();

                        if (data.success) {
                            // Update active states
                            stars.forEach((s, i) => {
                                if (i < ratingValue) {
                                    s.classList.add('fa-solid', 'active');
                                    s.classList.remove('fa-regular');
                                } else {
                                    s.classList.remove('fa-solid', 'active');
                                    s.classList.add('fa-regular');
                                }
                            });

                            // Update average display
                            const section = group.closest('.movie-rating-section');
                            if (section) {
                                const avgEl = section.querySelector('.avg-rating-value');
                                if (avgEl) avgEl.textContent = data.data.promedio.toFixed(1);
                                
                                // Update average stars display
                                const starsDisplay = section.querySelector('.stars-display');
                                if (starsDisplay) {
                                    const avg = data.data.promedio;
                                    let starsHtml = '';
                                    for (let i = 1; i <= 5; i++) {
                                        if (i <= Math.floor(avg)) {
                                            starsHtml += '<i class="fa-solid fa-star star-filled"></i>';
                                        } else if (i - 0.5 <= avg) {
                                            starsHtml += '<i class="fa-solid fa-star-half-stroke star-filled"></i>';
                                        } else {
                                            starsHtml += '<i class="fa-regular fa-star star-empty"></i>';
                                        }
                                    }
                                    starsDisplay.innerHTML = starsHtml;
                                }
                            }

                            if (typeof showToast === 'function') {
                                showToast('¡Calificación Enviada!', `Has calificado con ${ratingValue} estrella${ratingValue > 1 ? 's' : ''}.`, 'success');
                            }
                        } else {
                            if (typeof showToast === 'function') {
                                showToast('Error', data.message || 'No se pudo enviar la calificación.', 'error');
                            }
                        }
                    } catch (err) {
                        console.error('Error al calificar:', err);
                        if (typeof showToast === 'function') {
                            showToast('Error de Red', 'No se pudo conectar con el servidor.', 'error');
                        }
                    }
                });
            });
        });
    });
</script>

<%- include('partials/footer') %>
