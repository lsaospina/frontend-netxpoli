<%- include('partials/header') %>

<div class="dashboard-container">
    <!-- Banner de bienvenida -->
    <div class="welcome-banner">
        <div class="welcome-text">
            <h2>¡Hola, <%= user.nombre %> <%= user.apellido %>!</h2>
            <p>Bienvenido al panel del sistema de alquiler de películas.</p>
        </div>
        <div>
            <div class="user-badge <%= user.tipo_usuario %>">
                <% if (user.tipo_usuario === 'administrador') { %>
                    <i class="fa-solid fa-user-shield"></i> Administrador
                <% } else if (user.tipo_usuario === 'gerente') { %>
                    <i class="fa-solid fa-user-tie"></i> Gerente
                <% } else { %>
                    <i class="fa-solid fa-user"></i> Cliente
                <% } %>
            </div>
        </div>
    </div>

    <!-- Título de sección de acuerdo al rol -->
    <h3 style="margin: 2rem 0 1rem 0; font-size: 1.6rem; color: var(--text-main);">
        Acciones Disponibles para tu Rol
    </h3>

    <!-- Grid de tarjetas de características de acuerdo al rol del usuario -->
    <div class="features-grid">
        <% if (user.tipo_usuario === 'cliente') { %>
            <!-- Tarjetas de Cliente -->
            <div class="feature-card role-accent-cliente">
                <div class="feature-icon" style="color: var(--color-cliente);">
                    <i class="fa-solid fa-compact-disc"></i>
                </div>
                <h4 class="feature-title">Explorar Cartelera</h4>
                <p class="feature-desc">Navega por nuestro catálogo de películas de estreno, acción, comedia, terror y clásicos de culto disponibles para alquiler.</p>
                <a href="/catalog" class="feature-action-btn">Ver Catálogo</a>
            </div>

            <div class="feature-card role-accent-cliente">
                <div class="feature-icon" style="color: var(--color-cliente);">
                    <i class="fa-solid fa-ticket"></i>
                </div>
                <h4 class="feature-title">Mis Alquileres</h4>
                <p class="feature-desc">Revisa tus películas rentadas activas, fechas de devolución, y reproduce tus películas directamente en línea.</p>
                <a href="/rentals" class="feature-action-btn">Ver Alquileres</a>
            </div>

            <div class="feature-card role-accent-cliente">
                <div class="feature-icon" style="color: var(--color-cliente);">
                    <i class="fa-solid fa-credit-card"></i>
                </div>
                <h4 class="feature-title">Método de Pago</h4>
                <p class="feature-desc">Gestiona tus tarjetas de crédito, saldo de NetPolix, y revisa el historial de transacciones anteriores.</p>
                <a href="#" class="feature-action-btn">Configurar Pagos</a>
            </div>

            <div class="feature-card role-accent-cliente">
                <div class="feature-icon" style="color: var(--color-cliente);">
                    <i class="fa-solid fa-user-plus"></i>
                </div>
                <h4 class="feature-title">Refiere y Gana</h4>
                <p class="feature-desc">Invita a tus amigos a unirse a NetPolix y obtén $5.00 de saldo por cada amigo que se registre con tu enlace.</p>
                <div class="referral-mini-counter" style="margin-top: auto; font-size: 0.9rem; color: var(--text-muted); display: flex; justify-content: space-between; align-items: center; width: 100%; border-top: 1px solid var(--border-subtle); padding-top: 0.75rem; margin-bottom: 0.75rem;">
                    <span>Amigos referidos:</span>
                    <strong style="color: var(--color-cliente); font-size: 1.1rem;"><%= typeof referredCount !== 'undefined' ? referredCount : 0 %></strong>
                </div>
                <button class="feature-action-btn" id="btn-referral" data-username="<%= user.username %>" style="border: none; cursor: pointer; width: 100%; font-family: var(--font-body); background: linear-gradient(135deg, var(--color-cliente), rgba(50, 205, 50, 0.7)); color: #fff; font-weight: 500;">
                    <i class="fa-solid fa-gift"></i> Obtener Enlace
                </button>
            </div>

        <% } else if (user.tipo_usuario === 'gerente') { %>
            <!-- Tarjetas de Gerente -->
            <div class="feature-card role-accent-gerente">
                <div class="feature-icon" style="color: var(--color-gerente);">
                    <i class="fa-solid fa-tags"></i>
                </div>
                <h4 class="feature-title">Inventario de Películas</h4>
                <p class="feature-desc">Agrega nuevos títulos a la cartelera, ajusta precios de alquiler, edita stock y define películas en oferta especial.</p>
                <a href="/catalog" class="feature-action-btn">Ir a Catálogo</a>
            </div>

            <div class="feature-card role-accent-gerente">
                <div class="feature-icon" style="color: var(--color-gerente);">
                    <i class="fa-solid fa-chart-line"></i>
                </div>
                <h4 class="feature-title">Reportes y Estadísticas</h4>
                <p class="feature-desc">Visualiza las películas más rentadas de la semana, ingresos acumulados y horas de mayor consumo de películas.</p>
                <a href="/reports" class="feature-action-btn">Ver Reportes</a>
            </div>

            <div class="feature-card role-accent-gerente">
                <div class="feature-icon" style="color: var(--color-gerente);">
                    <i class="fa-solid fa-percent"></i>
                </div>
                <h4 class="feature-title">Descuentos y Promos</h4>
                <p class="feature-desc">Crea cupones de descuento especiales para los clientes recurrentes e implementa promociones de fin de semana.</p>
                <a href="#" class="feature-action-btn">Gestionar Cupones</a>
            </div>

        <% } else if (user.tipo_usuario === 'administrador') { %>
            <!-- Tarjetas de Administrador -->
            <div class="feature-card role-accent-administrador">
                <div class="feature-icon" style="color: var(--color-admin);">
                    <i class="fa-solid fa-users-gear"></i>
                </div>
                <h4 class="feature-title">Gestión de Usuarios</h4>
                <p class="feature-desc">Edita la información de los usuarios registrados, cambia contraseñas y promueve clientes a Gerentes o Administradores.</p>
                <a href="#" class="feature-action-btn">Ver Usuarios</a>
            </div>

            <div class="feature-card role-accent-administrador">
                <div class="feature-icon" style="color: var(--color-admin);">
                    <i class="fa-solid fa-film"></i>
                </div>
                <h4 class="feature-title">Catálogo y Películas</h4>
                <p class="feature-desc">Administra el inventario de la cartelera: agrega nuevos títulos, ajusta detalles de precios, stock, sinopsis y portadas.</p>
                <a href="/admin/movies" class="feature-action-btn">Administrar Películas</a>
            </div>

            <div class="feature-card role-accent-administrador">
                <div class="feature-icon" style="color: var(--color-admin);">
                    <i class="fa-solid fa-database"></i>
                </div>
                <h4 class="feature-title">Mantenimiento de BD</h4>
                <p class="feature-desc">Realiza copias de seguridad de la base de datos SQLite y optimiza los índices de búsqueda del sistema.</p>
                <a href="#" class="feature-action-btn">Mantenimiento BD</a>
            </div>
        <% } %>
    </div>
</div>

<!-- Modal de Referidos Premium -->
<div id="referral-modal" class="referral-modal">
    <div class="referral-modal-content">
        <button id="referral-close" class="referral-close-btn">&times;</button>
        
        <div class="referral-modal-header">
            <div class="referral-modal-icon-glow">
                <i class="fa-solid fa-gift"></i>
            </div>
            <h2>Refiere y Gana</h2>
            <p>Comparte la experiencia NetPolix y gana saldo</p>
        </div>

        <div class="referral-modal-body">
            <p class="referral-instructions">
                Copia tu enlace de invitación y compártelo. Por cada amigo que se registre con tu enlace, ¡ambos recibirán un bono de saldo en su cuenta de NetPolix de forma gratuita!
            </p>
            
            <div class="referral-link-container">
                <input type="text" id="referral-link-input" readonly value="" placeholder="Generando enlace...">
                <button id="btn-copy-referral" class="btn-copy-link">
                    <i class="fa-solid fa-copy"></i> Copiar
                </button>
            </div>
            
            <div class="referral-stats-mini">
                <div class="stat-item">
                    <span class="stat-num"><%= typeof referredCount !== 'undefined' ? referredCount : 0 %></span>
                    <span class="stat-label">Amigos Registrados</span>
                </div>
                <div class="stat-item">
                    <span class="stat-num">$<%= (typeof referredCount !== 'undefined' ? referredCount : 0) * 5 %>.00</span>
                    <span class="stat-label">Saldo Acumulado</span>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
