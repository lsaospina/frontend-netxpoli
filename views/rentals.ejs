<%- include('partials/header') %>

<div class="rentals-container">
    <div class="rentals-header">
        <h1>Mis Alquileres</h1>
        <p>Aquí puedes reproducir tus películas rentadas activas o realizar la devolución al catálogo.</p>
    </div>

    <% if (rentals.length === 0) { %>
        <!-- Vista vacía de Alquileres -->
        <div class="no-results-container">
            <i class="fa-solid fa-ticket-simple"></i>
            <h3>No tienes alquileres activos</h3>
            <p>Explora el catálogo y alquila tus títulos preferidos para que aparezcan aquí.</p>
            <a href="/catalog" class="feature-action-btn" style="margin-top: 1.5rem; display: inline-block;">Explorar Catálogo</a>
        </div>
    <% } else { %>
        <!-- Grid de Alquileres -->
        <div class="rentals-grid">
            <% rentals.forEach(function(rental) { %>
                <div class="rental-card <%= rental.estado %>" id="rental-card-<%= rental.rental_id %>">
                    <!-- Portada de la película -->
                    <div class="rental-poster">
                        <img src="<%= rental.imagen_url %>" alt="<%= rental.titulo %>">
                        <span class="rental-status-badge <%= rental.estado %>">
                            <% if (rental.estado === 'activo') { %>
                                <span class="pulse-dot"></span> Activo
                            <% } else { %>
                                Devuelto
                            <% } %>
                        </span>
                    </div>

                    <!-- Detalles del Alquiler -->
                    <div class="rental-details">
                        <h3 class="rental-title"><%= rental.titulo %></h3>
                        <p class="rental-info"><i class="fa-regular fa-folder"></i> Género: <span><%= rental.genero %></span></p>
                        <p class="rental-info"><i class="fa-regular fa-user"></i> Director: <span><%= rental.director %></span></p>
                        <p class="rental-info"><i class="fa-regular fa-clock"></i> Duración: <span><%= rental.duracion %> min</span></p>
                        
                        <div class="rental-dates">
                            <div>
                                <span class="date-label">Alquilado el:</span>
                                <span class="date-value"><%= new Date(rental.fecha_alquiler).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' }) %></span>
                            </div>
                            <div>
                                <span class="date-label">Devolver antes de:</span>
                                <span class="date-value return-date"><%= new Date(rental.fecha_devolucion).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' }) %></span>
                            </div>
                        </div>

                        <!-- Botones de Acción -->
                        <div class="rental-actions">
                            <% if (rental.estado === 'activo') { %>
                                <button class="btn-play-movie" data-title="<%= rental.titulo %>" data-image="<%= rental.imagen_url %>">
                                    <i class="fa-solid fa-play"></i> Reproducir
                                </button>
                                <button class="btn-return-movie-action" data-id="<%= rental.rental_id %>" data-title="<%= rental.titulo %>">
                                    <i class="fa-solid fa-rotate-left"></i> Devolver
                                </button>
                            <% } else { %>
                                <button class="btn-play-movie disabled" disabled>
                                    <i class="fa-solid fa-ban"></i> No disponible
                                </button>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } %>
</div>

<!-- Modal del Reproductor de Video Simulado -->
<div id="player-modal" class="player-modal">
    <div class="player-modal-content">
        <button id="player-close" class="player-close-btn">&times;</button>
        <div class="player-wrapper">
            <!-- Loader inicial -->
            <div class="player-loader">
                <span class="player-spinner"></span>
                <p>Estableciendo conexión segura...</p>
                <p class="player-loader-sub">NetPolix UltraStream v2.4</p>
            </div>
            <!-- Pantalla del Reproductor -->
            <div class="player-screen" style="display: none;">
                <div class="player-video-mock">
                    <div class="mock-video-poster" id="player-video-poster"></div>
                    <div class="mock-play-overlay">
                        <i class="fa-solid fa-play"></i>
                    </div>
                    <!-- Ondas visuales simuladas -->
                    <div class="audio-waves" id="audio-waves" style="display: none;">
                        <span></span><span></span><span></span><span></span><span></span>
                    </div>
                </div>
                <!-- Barra de Controles -->
                <div class="player-controls">
                    <button class="control-btn" id="player-play-btn"><i class="fa-solid fa-pause"></i></button>
                    <div class="progress-bar-container">
                        <span class="time-elapsed">00:00</span>
                        <div class="progress-bar-rail">
                            <div class="progress-bar-fill" id="player-progress-fill" style="width: 0%;"></div>
                        </div>
                        <span class="time-total" id="player-time-total">02:28:00</span>
                    </div>
                    <div class="volume-container">
                        <i class="fa-solid fa-volume-high"></i>
                        <div class="volume-bar-rail">
                            <div class="volume-bar-fill" style="width: 80%;"></div>
                        </div>
                    </div>
                    <button class="control-btn" id="player-fullscreen-btn"><i class="fa-solid fa-expand"></i></button>
                </div>
            </div>
        </div>
        <div class="player-details">
            <h2 id="player-movie-title">Título de la Película</h2>
            <p><i class="fa-solid fa-shield-halved"></i> Contenido Protegido por Derechos de Autor. Transmitiendo en Full HD 1080p.</p>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
